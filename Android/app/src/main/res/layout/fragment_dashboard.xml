<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Статус -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1E1E1E"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvCurrentMode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Режим: MANUAL"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/tvDayNight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀️ ДЕНЬ"
                android:textSize="19sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- ПОВІТРЯ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌡️ ПОВІТРЯ"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvAirTemp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Температура: -- °C"
                android:textSize="17sp"
                android:textColor="#4CAF50"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvPressure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Тиск: -- мм рт. ст."
                android:textSize="17sp"
                android:textColor="#4CAF50"/>
        </LinearLayout>

        <!-- ҐРУНТ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1E1E1E"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/ivSoil"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:background="#2C2C2C"
                android:contentDescription="Ґрунт"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌱 ҐРУНТ"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvSoilTemp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Температура: -- °C"
                    android:textSize="17sp"
                    android:textColor="#FF9800"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvSoilMoisture"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Вологість: -- %"
                    android:textSize="17sp"
                    android:textColor="#2196F3"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Режими -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Режим роботи"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnManual"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="MANUAL"
                android:textSize="16sp"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnDay"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="☀️ ДЕНЬ"
                android:textSize="16sp"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnNight"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="🌙 НІЧ"
                android:textSize="16sp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>