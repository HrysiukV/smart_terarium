<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#121212">

    <TextView
        android:id="@+id/txtDebug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="STATUS"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:paddingBottom="8dp"/>

    <!-- ROW 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="3"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAll"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:text="ALL"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:gravity="center"
            android:textAlignment="center"
            android:clickable="true"
            android:checkable="true"
            app:chipCornerRadius="22dp"
            app:chipBackgroundColor="#2A2A2A"
            app:chipStrokeWidth="1.5dp"
            app:chipStrokeColor="#FFFFFF"
            app:checkedIconVisible="false"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipOn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:text="ON"
            android:textColor="#76FF03"
            android:textStyle="bold"
            android:gravity="center"
            android:textAlignment="center"
            android:clickable="true"
            android:checkable="true"
            app:chipCornerRadius="22dp"
            app:chipBackgroundColor="#2A2A2A"
            app:chipStrokeWidth="1.5dp"
            app:chipStrokeColor="#76FF03"
            app:checkedIconVisible="false"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipOff"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:text="OFF"
            android:textColor="#F44336"
            android:textStyle="bold"
            android:gravity="center"
            android:textAlignment="center"
            android:clickable="true"
            android:checkable="true"
            app:chipCornerRadius="22dp"
            app:chipBackgroundColor="#2A2A2A"
            app:chipStrokeWidth="1.5dp"
            app:chipStrokeColor="#F44336"
            app:checkedIconVisible="false"/>

    </LinearLayout>

    <!-- ROW 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="3"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLight"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:text="💡 LIGHT"
            android:textColor="#F5C842"
            android:textStyle="bold"
            android:gravity="center"
            android:textAlignment="center"
            android:clickable="true"
            android:checkable="true"
            app:chipCornerRadius="22dp"
            app:chipBackgroundColor="#2A2A2A"
            app:chipStrokeWidth="1.5dp"
            app:chipStrokeColor="#F5C842"
            app:checkedIconVisible="false"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPump"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:text="💧 PUMP"
            android:textColor="#42A5F5"
            android:textStyle="bold"
            android:gravity="center"
            android:textAlignment="center"
            android:clickable="true"
            android:checkable="true"
            app:chipCornerRadius="22dp"
            app:chipBackgroundColor="#2A2A2A"
            app:chipStrokeWidth="1.5dp"
            app:chipStrokeColor="#42A5F5"
            app:checkedIconVisible="false"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipHeat"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:text="🔥 HEAT"
            android:textColor="#FF6D00"
            android:textStyle="bold"
            android:gravity="center"
            android:textAlignment="center"
            android:clickable="true"
            android:checkable="true"
            app:chipCornerRadius="22dp"
            app:chipBackgroundColor="#2A2A2A"
            app:chipStrokeWidth="1.5dp"
            app:chipStrokeColor="#FF6D00"
            app:checkedIconVisible="false"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewLog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="4dp"/>

</LinearLayout>